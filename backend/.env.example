# Backend Environment Variables - Production
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://grepmind_prod:CHANGE-PASSWORD@grepmind-dashboard-postgresql:5432/grepmind_dashboard_prod

# JWT Secret (MUST BE CHANGED!)
JWT_SECRET=CHANGE-TO-SECURE-PRODUCTION-JWT-SECRET-KEY-256-BITS-MINIMUM
JWT_REFRESH_SECRET=CHANGE-TO-SECURE-PRODUCTION-REFRESH-SECRET-KEY-256-BITS-MINIMUM
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://dashboard.grepmind.com

# Kubernetes Configuration
KUBERNETES_NAMESPACE=default
KUBERNETES_IN_CLUSTER=true

# App Configuration
APP_NAME=GrepMind Dashboard
APP_VERSION=1.0.0

# Rate Limiting (Production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# Logging
LOG_LEVEL=warn